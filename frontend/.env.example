# ============================================================
# Frontend Environment Variables (LOCAL DEVELOPMENT ONLY)
# ============================================================
# Copy this file to .env.local for local development.
# For production (Vercel), set env vars in the Vercel dashboard:
#   Settings → Environment Variables
# Vercel does NOT read .env files from the repo.
# ============================================================

# Backend API URL — must match your local backend's port
NEXT_PUBLIC_API_URL=http://localhost:5001/api

# Production value (set in Vercel dashboard, NOT here):
# NEXT_PUBLIC_API_URL=https://new-pi-classes.onrender.com/api
