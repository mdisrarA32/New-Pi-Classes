# ============================================================
# Backend Environment Variables (LOCAL DEVELOPMENT ONLY)
# ============================================================
# Copy this file to .env for local development.
# For production (Render), set env vars in the Render dashboard:
#   Dashboard → Your Service → Environment
# Render does NOT read .env files from the repo.
# ============================================================

PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Production value for FRONTEND_URL (set in Render dashboard, NOT here):
# FRONTEND_URL=https://new-pi-classes.vercel.app

# Database
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/npc_db?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your_jwt_secret_key_here
SEED_ADMIN_PASSWORD=your_secure_admin_seed_password_here

# File Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Chatbot (Groq API)
GROQ_API_KEY=your_groq_api_key
